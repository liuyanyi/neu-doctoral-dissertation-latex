{
  "NEU 基础元数据配置": {
    "scope": "latex",
    "prefix": "neu-setup-basic",
    "body": [
      "\\documentclass[final-cover]{neudissertation}",
      "",
      "\\neudisetup{",
      "  classification = {${1:}},",
      "  security-level = {${2:}},",
      "  udc = {${3:}},",
      "  student-id = {${4:学号}},",
      "  title-cn = {${5:中文题名}},",
      "  title-en = {${6:English Title}},",
      "  author-cn = {${7:作者姓名}},",
      "  author-en = {${8:Author Name}},",
      "  college-cn = {${9:学院名称}},",
      "  major-cn = {${10:专业名称}},",
      "  major-en = {${11:Major Name}},",
      "  degree-level = {${12:博士}},",
      "  discipline = {${13:工学}},",
      "  supervisor-cn = {${14:导师姓名}},",
      "  supervisor-title-cn = {${15:教授}},",
      "  supervisor-affiliation-cn = {${16:东北大学}},",
      "  supervisor-en = {${17:Professor Name}},",
      "  submit-year = {${18:2026}},",
      "  submit-month = {${19:4}},",
      "  defense-year = {${20:2026}},",
      "  defense-month = {${21:5}},",
      "  degree-year = {${22:2026}},",
      "  degree-month = {${23:6}},",
      "  cover-year = {${24:2026}},",
      "  cover-month = {${25:6}}",
      "}"
    ],
    "description": "插入基础 neudisetup 元数据配置（最终版封面）"
  },
